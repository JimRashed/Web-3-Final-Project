# Copy to .env (git-ignored) and fill in local-only values. Never commit .env.
# Used by: docker compose --env-file .env -f infra/compose.yaml up -d
#          node --env-file=.env infra/oidc/provision-demo-users.mjs
#          node --env-file=.env infra/oidc/verify-oidc.mjs

# Keycloak bootstrap administrator (master realm, local development only).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Confidential credential for the Gameplay machine client (quizarena-gameplay).
# Generate a long random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Applied on the first realm import only; rotate later in the Keycloak admin console.
QUIZARENA_GAMEPLAY_CLIENT_SECRET=

# Password for the local demo players (player-a, player-b) created by provision-demo-users.mjs.
QUIZARENA_DEMO_PASSWORD=

# Public OIDC settings (safe to share). APIs and the React client read their own equivalents.
OIDC_AUTHORITY=http://localhost:8080/realms/quizarena
OIDC_CLIENT_ID=quizarena-client
